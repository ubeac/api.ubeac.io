{
  "RabbitMQ": {
    "PostProcessorConsumer": {
      "ConnectionStringName": "RabbitMQConnection",
      "QueueName": "toPostProcessor",
      "BatchSize": 200
    },
    "GatewayProducer": {
      "ConnectionStringName": "RabbitMQConnection",
      "QueueName": "toGatewayProcessor"
    },
    "SensorProducer": {
      "ConnectionStringName": "RabbitMQConnection",
      "QueueName": "toSensorProcessor"
    },
    "DeviceProducer": {
      "ConnectionStringName": "RabbitMQConnection",
      "QueueName": "toDeviceProcessor"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
