{  
  "AppConfig": {
    "Name": "uBeacApi",
    "Description": "User Api for uBeac project",
    "Version": "v1"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "MailServerSettings": {
    "Name": "Office365",
    "Username": "<smtp-username>",
    "SenderEmail": "members@ubeac.io",
    "SenderDisplayName": "uBeac Members Notification",
    "Password": "<smtp-password>",
    "Host": "smtp.office365.com",
    "Port": 587,
    "EnableSsl": "true"
  },
  "AESIV": "<aes-iv-base64>",
  "AESKey": "<aes-key-base64>"
}